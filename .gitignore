# ==========================================
# Log của các trình quản lý thư viện (npm, yarn, pnpm)
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Thư mục thư viện (Tuyệt đối không push lên Git)
# ==========================================
node_modules/

# ==========================================
# Thư mục chứa code sau khi build (Vite)
# ==========================================
dist/
dist-ssr/
*.local

# ==========================================
# File cấu hình môi trường (Bảo mật)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==========================================
# Cấu hình IDE và Hệ điều hành
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.class
*.exe
*.so
*.dll

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
